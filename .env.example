# Copy to .env (never commit .env). Used by docker-compose.yml.

# Postgres password for the bundled database container.
POSTGRES_PASSWORD=change-me

# Signs login tokens; 32+ random characters. Changing it logs everyone out.
# e.g.  openssl rand -hex 32
TOKEN_SECRET=

# Password for "admin" in the first company, set on first boot only.
# Leave empty to have a random one printed once in the server log.
INITIAL_ADMIN_PASSWORD=

# Host port for the API (container listens on 8080).
SERVER_PORT=8080
